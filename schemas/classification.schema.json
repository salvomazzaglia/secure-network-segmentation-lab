{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/salvomazzaglia/secure-network-segmentation-lab/schemas/classification.schema.json",
  "title": "Classification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "device_id",
    "predicted_class",
    "confidence",
    "classification_status"
  ],
  "properties": {
    "device_id": {
      "type": "string"
    },
    "predicted_class": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class",
          "confidence"
        ],
        "properties": {
          "class": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "label",
          "weight",
          "contribution",
          "detail"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          },
          "contribution": {
            "type": "number"
          },
          "detail": {
            "type": "string"
          },
          "provenance": {
            "type": "string"
          }
        }
      }
    },
    "classification_status": {
      "enum": [
        "classified",
        "uncertain",
        "unknown",
        "manually_reviewed"
      ]
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "explanation": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "banner": {
      "type": "string"
    }
  }
}
