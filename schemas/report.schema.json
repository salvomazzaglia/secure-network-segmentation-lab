{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/salvomazzaglia/secure-network-segmentation-lab/schemas/report.schema.json",
  "title": "ReportEnvelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "report_type",
    "version",
    "generated_at_utc",
    "banner",
    "synthetic"
  ],
  "properties": {
    "report_type": {
      "enum": [
        "inventory",
        "classification",
        "policy",
        "reachability",
        "quarantine",
        "drift",
        "topology",
        "audit"
      ]
    },
    "version": {
      "type": "string"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "banner": {
      "type": "string"
    },
    "synthetic": {
      "type": "boolean"
    },
    "change_label": {
      "type": "string"
    },
    "summary": {
      "type": "object"
    },
    "items": {
      "type": "array"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
